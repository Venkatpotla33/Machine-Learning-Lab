import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures, StandardScaler
from sklearn.svm import SVR

# ================================================================
# 1. Create Regression Dataset
# ================================================================
np.random.seed(0)
X = np.linspace(0, 10, 50).reshape(-1, 1)
y = 3 * X.squeeze() + 5 + np.random.randn(50) * 2  # Linear + Noise

# ================================================================
# 2. Regression Metrics Function
# ================================================================
def regression_metrics(y_true, y_pred):
    print("MAE:", mean_absolute_error(y_true, y_pred))
    print("MSE:", mean_squared_error(y_true, y_pred))
    print("RMSE:", np.sqrt(mean_squared_error(y_true, y_pred)))
    print("R² Score:", r2_score(y_true, y_pred))
    print("-" * 50)

# ================================================================
# 3. Linear Regression
# ================================================================
print("\n==== Linear Regression ====")
lin_reg = LinearRegression()
lin_reg.fit(X, y)
y_pred_lin = lin_reg.predict(X)
regression_metrics(y, y_pred_lin)

plt.scatter(X, y, label="Actual")
plt.plot(X, y_pred_lin, color='red', label="Predicted")
plt.title("Linear Regression")
plt.legend()
plt.show()

# ================================================================
# 4. Polynomial Regression (degree=3)
# ================================================================
print("\n==== Polynomial Regression (Degree 3) ====")
poly = PolynomialFeatures(degree=3)
X_poly = poly.fit_transform(X)

poly_reg = LinearRegression()
poly_reg.fit(X_poly, y)
y_pred_poly = poly_reg.predict(X_poly)

regression_metrics(y, y_pred_poly)

plt.scatter(X, y, label="Actual")
plt.plot(X, y_pred_poly, color='green', label="Predicted")
plt.title("Polynomial Regression")
plt.legend()
plt.show()

# ================================================================
# 5. Support Vector Regression (SVR)
# ================================================================
print("\n==== Support Vector Regression (SVR) ====")
sc_x = StandardScaler()
sc_y = StandardScaler()

X_scaled = sc_x.fit_transform(X)
y_scaled = sc_y.fit_transform(y.reshape(-1, 1)).flatten()

svr = SVR(kernel='rbf', C=50, epsilon=0.2)
svr.fit(X_scaled, y_scaled)
y_pred_svr = sc_y.inverse_transform(svr.predict(X_scaled).reshape(-1, 1)).flatten()

regression_metrics(y, y_pred_svr)

plt.scatter(X, y, label="Actual")
plt.plot(X, y_pred_svr, color='purple', label="Predicted")
plt.title("SVR Regression")
plt.legend()
plt.show()

# ================================================================
# 6. Data Parallelism Simulation
# ================================================================
print("\n==== Data Parallelism Simulation ====")

def compute_gradient(batch_X, batch_y, w):
    y_pred = batch_X.dot(w)
    grad = (2 / len(batch_X)) * batch_X.T.dot(y_pred - batch_y)
    return grad

X_dp = np.c_[np.ones((50, 1)), X]   # Bias term
y_dp = y
w = np.zeros(2)
lr = 0.01
workers = 5

batches = np.array_split(np.c_[X_dp, y_dp], workers)

for epoch in range(20):
    gradients = []
    for batch in batches:
        batch_X = batch[:, :2]
        batch_y = batch[:, 2]
        gradients.append(compute_gradient(batch_X, batch_y, w))

    avg_grad = np.mean(gradients, axis=0)
    w -= lr * avg_grad

print("Final Weights from Data Parallelism:", w)

# ================================================================
# 7. Model Parallelism Simulation
# ================================================================
print("\n==== Model Parallelism Simulation ====")

def layer1(x, w1):
    return x * w1

def layer2(z, w2):
    return z + w2

w1, w2 = 2.0, 3.0
lr = 0.01

for epoch in range(20):
    z = layer1(X.flatten(), w1)
    y_pred = layer2(z, w2)

    error = y_pred - y
    grad_w2 = np.mean(error)
    grad_w1 = np.mean(error * X.flatten())

    w1 -= lr * grad_w1
    w2 -= lr * grad_w2

print("Final Model Parallel Weights:", w1, w2)

# ================================================================
# 8. Q-Learning Tabular Example
# ================================================================
print("\n==== Q-Learning Example ====")

states = [0, 1, 2, 3]
actions = [0, 1]

Q = np.zeros((4, 2))

alpha = 0.5
gamma = 0.9
epsilon = 0.2

rewards = {
    (0, 0): (1, 1),
    (0, 1): (0, 2),
    (1, 0): (2, 3),
    (1, 1): (-1, 0),
    (2, 0): (1, 3),
    (2, 1): (0, 1),
    (3, 0): (0, 3),
    (3, 1): (0, 3)
}

for episode in range(50):
    state = np.random.choice(states)
    for step in range(20):
        if np.random.rand() < epsilon:
            action = np.random.choice(actions)
        else:
            action = np.argmax(Q[state])

        reward, next_state = rewards[(state, action)]

        Q[state, action] += alpha * (
            reward + gamma * np.max(Q[next_state]) - Q[state, action]
        )

        state = next_state

print("\nFinal Q-Table:")
print(Q)
